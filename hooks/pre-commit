#!/usr/bin/env bash
# ==============================================================================
# pre-commit — governança do bbsia-radar
# Exige NEWS.md junto com mudanças e bloqueia caminhos absolutos em linhas novas.
# Ative no clone com: git config core.hooksPath hooks
# ==============================================================================
set -u
set -o pipefail
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0
falhou=0
if ! printf '%s\n' "$staged" | grep -qx 'NEWS.md'; then
  echo "pre-commit: NEWS.md precisa entrar no mesmo commit (regra do AGENTS.md)." >&2
  falhou=1
fi
if ! git diff --cached --no-ext-diff --no-color --unified=0 --diff-filter=ACMR -- \
  | bash tools/check-absolute-paths.sh; then
  falhou=1
fi
exit "$falhou"
