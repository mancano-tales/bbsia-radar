#!/usr/bin/env bash
# Verifica as alterações ainda não publicadas antes de enviar cada ref.
set -u
set -o pipefail
remote=origin
if [ "$#" -ge 1 ]; then remote=$1; fi
zeros=0000000000000000000000000000000000000000
falhou=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  [ "$local_sha" = "$zeros" ] && continue
  if [ "$remote_sha" = "$zeros" ]; then
    default_ref=$(git symbolic-ref --quiet "refs/remotes/$remote/HEAD" || true)
    if [ -z "$default_ref" ]; then
      for candidato in "refs/remotes/$remote/main" "refs/remotes/$remote/master"; do
        if git show-ref --quiet --verify "$candidato"; then
          default_ref=$candidato
          break
        fi
      done
    fi
    base=""
    if [ -n "$default_ref" ]; then
      base=$(git merge-base "$default_ref" "$local_sha" 2>/dev/null || true)
    fi
  else
    base=$remote_sha
  fi
  if [ -n "$base" ]; then
    faixa="$base..$local_sha"
    if ! git log --diff-merges=first-parent --format= --no-color --no-ext-diff --unified=0 -p "$faixa" -- \
      | bash tools/check-absolute-paths.sh; then
      falhou=1
    fi
  else
    if ! git log --root --diff-merges=first-parent --format= --no-color --no-ext-diff --unified=0 -p "$local_sha" -- \
      | bash tools/check-absolute-paths.sh; then
      falhou=1
    fi
  fi
done
exit "$falhou"
